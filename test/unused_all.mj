program UnusedAll

const int C = 10;

{
	// Formal p se ne cita u telu - NIJE unused (fpPos), ali lokal ghost jeste
	void helper(int p)
	int ghost, live;
	{
		ghost = p + 1;          // ghost unused: RHS cita p -> load p, add, pop (nema store ghost)
		live = 7;
		print(live);            // 7
		// p se ne cita kao "vrednost koju printujemo", ali jeste procitan u ghost = p+1
	}

	void main()
	int a, b, c, d, e, f, g, h;
	{
		// =====================================================================
		// 1) Koriscena promenljiva - obican store/load
		// =====================================================================
		a = 1;
		print(a);               // 1

		// =====================================================================
		// 2) Unused + const RHS - nestaje potpuno (nema const ni store)
		// =====================================================================
		b = 2 + 3;              // fold 5, pa skip
		b = C * 2;              // fold 20, pa skip
		c = (1 + 1) * 4;        // fold 8, pa skip

		// =====================================================================
		// 3) Unused + ne-const RHS - racuna se, pa pop
		// =====================================================================
		d = a + 1;              // load a, const 1, add, pop
		e = a * (2 + 2);        // load a, const 4, mul, pop

		// =====================================================================
		// 4) Vise dodela u unused - sve bez store
		// =====================================================================
		f = 100;
		f = a + 2;              // druga dodela: pop
		f = 3;                  // const - nestaje

		// =====================================================================
		// 5) DCE + unused: citanje samo u mrtvom kodu => unused
		// =====================================================================
		g = 9;                  // unused (print(g) je mrtav)
		if (false)
			print(g);           // mrtva grana - ne cini g "read"
		else
			print(2);           // 2

		// =====================================================================
		// 6) Promenljiva koja POSTANE koriscena (nije unused)
		// =====================================================================
		h = 3;
		h = h + 1;              // cita h -> h nije unused; oba store ostaju
		print(h);               // 4

		// =====================================================================
		// 7) Poziv metode (lokal ghost unused unutra)
		// =====================================================================
		helper(5);              // print 7 iz helper-a

		// =====================================================================
		// 8) Kontrola: a i dalje ziv
		// =====================================================================
		print(a);               // 1

		// Ocekivani ispis:
		// 1  2  4  7  1
		// => 12471
		//
		// Disasm (main) - ocekuj:
		// - store samo za a, h (i privremeno sto treba za h=h+1)
		// - NEMA store za b,c,d,e,f,g
		// - za b/c/f=const: nema ni loadConst dodela
		// - za d/e/f=a+...: load a ... pop
		// - helper: enter; load p ... pop za ghost; store live; print 7
	}
}
