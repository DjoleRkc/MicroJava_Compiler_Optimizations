program UnusedAll

const int C = 10;

{
	// Formalni parametar p se ne cita u telu - nije unused (fpPos > 0), ali lokal ghost jeste
	void helper(int p)
	int ghost, live;
	{
		ghost = p + 1;          // ghost se ne koristi nakon ovoga: desna strana cita p -> load p, add, pop (nema store ghost)
		live = 7;
		print(live);            // 7
		// p se ne cita kao "vrednost koju printujemo", ali jeste procitan u ghost = p+1
	}

	void main()
	int a, b, c, d, e, f, g, h;
	{
		// =====================================================================
		// 1) Koriscena promenljiva - obican store/load
		// =====================================================================
		a = 1;
		print(a);               // 1

		// =====================================================================
		// 2) Unused + const desna strana - nestaje potpuno (nema const ni store)
		// =====================================================================
		b = 2 + 3;              // fold 5, pa skip
		b = C * 2;              // fold 20, pa skip
		c = (1 + 1) * 4;        // fold 8, pa skip

		// =====================================================================
		// 3) Unused + ne-const desna strana - racuna se, pa pop
		// ========= ============================================================
		d = a + 1;              // load a, const 1, add, pop
		e = a * (2 + 2);        // load a, const 4, mul, pop

		// =====================================================================
		// 4) Vise dodela u unused - sve bez store
		// =====================================================================
		f = 100;
		f = a + 2;              // druga dodela: pop
		f = 3;                  // const - nestaje

		// =====================================================================
		// 5) dead code + unused: citanje samo u mrtvom kodu -> unused
		// =====================================================================
		g = 9;                  // unused (print(g) je mrtav)
		if (false)
			print(g);           // mrtva grana - ne cini g "iskoriscenim"
		else
			print(2);           // 2

		// =====================================================================
		// 6) Promenljiva koja postane koriscena (nije unused)
		// =====================================================================
		h = 3;
		h = h + 1;              // cita h -> h nije unused; oba store ostaju
		print(h);               // 4

		// =====================================================================
		// 7) Poziv metode (lokal ghost unused unutra)
		// =====================================================================
		helper(5);              // print 7 iz helper-a

		// =====================================================================
		// 8) Kontrola: a i dalje ziv
		// =====================================================================
		print(a);               // 1

		// Ocekivani ispis:
		// 1  2  4  7  1
		// => 12471
	}
}
